      "mainEntity": [
        {
          "@type": "Question",
          "name": "中医研究是否替代肝癌标准治疗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不替代。本专题定位于规范综合治疗背景下的支持性照护与相关结局观察，患者应依据专业医疗团队建议接受标准诊疗。"
          }
        },
        {
          "@type": "Question",
          "name": "研究重点观察哪些结局？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "重点可包括治疗相关症状、生活质量、体力与功能状态、营养、睡眠、安全性以及患者报告结局，并根据具体研究方案预先定义。"
          }
        },
        {
          "@type": "Question",
          "name": "网站是否提供个体处方？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不提供。本网站只介绍研究方向与学术信息，不能代替面对面的医疗评估、诊断和处方。"
          }
        }
      ]
