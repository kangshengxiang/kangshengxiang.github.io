          "@type": "Question",
          "name": "Does TCM research replace standard liver cancer treatment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. This programme studies supportive care and related outcomes alongside appropriate comprehensive treatment. Patients should follow treatment plans developed by qualified healthcare teams."
          }
        },
        {
          "@type": "Question",
          "name": "Which outcomes may be studied?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Outcomes may include treatment-related symptoms, quality of life, physical and functional status, nutrition, sleep, safety, and patient-reported outcomes defined in advance by each study protocol."
          }
        },
