      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does TCM research replace standard breast cancer treatment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The programme studies supportive care and rehabilitation alongside appropriate treatment. It does not replace surgery, radiotherapy, chemotherapy, endocrine therapy, targeted therapy, or other treatment recommended by qualified teams."
          }
        },
        {
          "@type": "Question",
          "name": "Which symptoms may be studied?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depending on the protocol, research may address fatigue, sleep, hot flushes, pain, emotional wellbeing, digestive symptoms, and functional recovery, while recording safety and concurrent treatment."
          }
        },
        {
          "@type": "Question",
          "name": "Can website information be used to make medication decisions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The website presents research information and does not provide individual prescriptions or replace professional assessment and medication guidance."
          }
        }
