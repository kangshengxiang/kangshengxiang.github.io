      "mainEntity": [
        {
          "@type": "Question",
          "name": "中医研究是否替代乳腺癌标准治疗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不替代。本专题在规范诊疗基础上关注支持性照护与康复结局，不能代替手术、放疗、化疗、内分泌治疗、靶向治疗或其他经专业团队建议的治疗。"
          }
        },
        {
          "@type": "Question",
          "name": "乳腺癌中医研究可关注哪些症状？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "可根据研究方案关注疲乏、睡眠、潮热、疼痛、情绪、消化道不适及功能恢复等问题，同时记录安全性和合并治疗。"
          }
        },
        {
          "@type": "Question",
          "name": "网站信息能否作为用药依据？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不能。本网站为研究信息介绍，不提供个体处方，也不能替代由合格医疗专业人员进行的风险评估与用药指导。"
          }
        }
      ]
    }
